#!/usr/bin/env node
// portable-sandbox: merge commits made inside the sandbox back into the target
// repo's git history. Safe alternative to round-tripping .git via rsync.
// Usage:
//   sandbox-merge [--config path/to/sandbox-config.yaml] [--dry-run]
//
// What it does:
//   1. Reads the source branch recorded at sandbox-up time
//      (workspace/.sandbox-broker-state/git-origin-branch.txt).
//   2. Verifies the target repo is on that same branch.
//   3. `git -C <target> fetch <workspace>/.git <branch>`
//   4. `git -C <target> merge --ff-only FETCH_HEAD`
//
// Why ff-only:
//   * If the host branch advanced since sandbox-up, fast-forward is impossible
//     — we refuse and tell the user to rebase manually inside the sandbox.
//     This avoids creating merge commits with workspace-side author identity.
//   * Pure ff means no new commit is authored on the host; the agent's
//     commits land verbatim (their SHAs are preserved).
//
// Why not push?
//   * The host stays in charge of remotes/credentials. After a successful
//     merge, you push from the host: `cd <target> && git push`.

import { existsSync } from "node:fs";
import path from "node:path";
import process from "node:process";
import { loadConfig } from "../lib/config.mjs";
import { workspacePathFor, readOriginBranch } from "../lib/prepare-workspace.mjs";
import { parseCliArgs } from "../lib/parse-cli-args.mjs";
import { createLog } from "../lib/log.mjs";
import { capture } from "../lib/run.mjs";

const log = createLog("sandbox-merge");

function gitOutput(args, cwd) {
  const r = capture("git", ["-C", cwd, ...args]);
  if (r.status !== 0) {
    throw new Error(`git ${args.join(" ")} failed in ${cwd}: ${r.stderr || r.stdout}`);
  }
  return r.stdout.trim();
}

const args = parseCliArgs(process.argv.slice(2), {
  flags: {
    configPath: { long: "--config",  takesValue: true },
    dryRun:     { long: "--dry-run", short: "-n" },
  },
  printHelp: () => console.log(`Usage: sandbox-merge [--config <path>] [--dry-run]
  --dry-run   show what would change but don't merge

Merges commits made inside the sandbox back into the target repo via
fast-forward only. Push from the target afterwards with: git push`),
});

const configPath = args.configPath || path.resolve(process.cwd(), "sandbox-config.yaml");
if (!existsSync(configPath)) {
  log.err(`config not found: ${configPath}`);
  process.exit(2);
}

const config = loadConfig(configPath);
const workspaceDir = workspacePathFor(config.target);

if (!existsSync(workspaceDir)) {
  log.err(`no workspace yet for ${config.target}`);
  console.error(`                run sandbox-up first.`);
  process.exit(2);
}

const workspaceGit = path.join(workspaceDir, ".git");
if (!existsSync(workspaceGit)) {
  log.err(`workspace has no .git directory: ${workspaceGit}`);
  console.error(`                this workspace predates the sandbox-merge feature.`);
  console.error(`                run: sandbox-discard --yes && sandbox-up`);
  process.exit(2);
}

const sourceBranch = readOriginBranch(workspaceDir);
if (!sourceBranch) {
  log.err(`missing source-branch record in workspace.`);
  console.error(`                expected: ${path.join(workspaceDir, ".sandbox-broker-state", "git-origin-branch.txt")}`);
  console.error(`                run: sandbox-discard --yes && sandbox-up`);
  process.exit(2);
}

// Sanity-check the target repo
if (!existsSync(path.join(config.target, ".git"))) {
  log.err(`target is not a git repo: ${config.target}`);
  process.exit(2);
}

const targetBranch = gitOutput(["rev-parse", "--abbrev-ref", "HEAD"], config.target);
if (targetBranch === "HEAD") {
  log.err(`target is in detached HEAD. Check out branch '${sourceBranch}' first.`);
  process.exit(3);
}
if (targetBranch !== sourceBranch) {
  log.err(`branch mismatch:`);
  console.error(`                target is on '${targetBranch}'`);
  console.error(`                workspace was cloned from '${sourceBranch}'`);
  console.error(`                run:  cd ${config.target} && git checkout ${sourceBranch}`);
  process.exit(3);
}

// Check the target tree is clean. Merging into a dirty tree can succeed but
// is confusing; refuse and let the user resolve.
const status = gitOutput(["status", "--porcelain"], config.target);
if (status) {
  log.err(`target has uncommitted changes:`);
  console.error(status.split("\n").map((l) => "                  " + l).join("\n"));
  console.error(`                commit, stash, or discard them before merging.`);
  process.exit(3);
}

log.err(`workspace: ${workspaceDir}`);
log.err(`target:    ${config.target}`);
log.err(`branch:    ${sourceBranch}`);
console.error("");

// Fetch from the workspace .git into the target.
const fetchSpec = `${sourceBranch}:refs/sandbox/${sourceBranch}`;
const fetchArgs = ["-C", config.target, "fetch", "--no-tags", workspaceGit, fetchSpec];
log.err(`git ${fetchArgs.slice(1).join(" ")}`);
const f = capture("git", fetchArgs);
if (f.status !== 0) {
  log.err(`fetch failed (exit ${f.status})`);
  if (f.stderr) process.stderr.write(f.stderr);
  process.exit(f.status || 1);
}
if (f.stderr) process.stderr.write(f.stderr);

// Compare: ahead/behind workspace vs target.
const ahead = gitOutput(["rev-list", "--count", `HEAD..refs/sandbox/${sourceBranch}`], config.target);
const behind = gitOutput(["rev-list", "--count", `refs/sandbox/${sourceBranch}..HEAD`], config.target);

if (ahead === "0" && behind === "0") {
  log.err(`workspace and target are at the same commit. nothing to merge.`);
  process.exit(0);
}
if (behind !== "0") {
  log.err(`non-fast-forward: target is ${behind} commit(s) ahead of workspace.`);
  console.error(`                workspace branch '${sourceBranch}' has diverged from target.`);
  console.error(`                resolve inside the sandbox: git rebase / merge, then re-run sandbox-merge.`);
  process.exit(3);
}

console.error("");
log.err(`workspace is ${ahead} commit(s) ahead. preview:`);
const gitLog = gitOutput([
  "log", "--oneline", "--no-decorate",
  `HEAD..refs/sandbox/${sourceBranch}`,
], config.target);
console.error(gitLog.split("\n").map((l) => "                  " + l).join("\n"));
console.error("");

if (args.dryRun) {
  log.err(`dry-run complete. re-run without --dry-run to fast-forward.`);
  process.exit(0);
}

const mergeArgs = ["-C", config.target, "merge", "--ff-only", `refs/sandbox/${sourceBranch}`];
log.err(`git ${mergeArgs.slice(1).join(" ")}`);
const m = capture("git", mergeArgs);
if (m.stdout) process.stdout.write(m.stdout);
if (m.stderr) process.stderr.write(m.stderr);
if (m.status !== 0) {
  log.err(`merge failed (exit ${m.status})`);
  process.exit(m.status || 1);
}

console.error("");
log.err(`merged. review with:  cd ${config.target} && git log --oneline -${ahead}`);
log.err(`push when ready:     cd ${config.target} && git push`);
